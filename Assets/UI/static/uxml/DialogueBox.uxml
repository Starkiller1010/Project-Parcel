    <ui:GroupBox name="DialogueBox" view-data-key="DialogueBox" class="dialogue-box" style="flex-direction: row; align-items: flex-end;">
        <ui:TextField name="DialogueText" password="false" readonly="true" is-delayed="false" multiline="true" data-source-type="Dialogue, Assembly-CSharp" data-source-path="text" focusable="true" select-all-on-focus="false" select-all-on-mouse-up="false" select-word-by-double-click="false" select-line-by-triple-click="false" emoji-fallback-support="false" hide-mobile-input="false" value="Test" placeholder-text="Where is this text?" hide-placeholder-on-focus="false" picking-mode="Ignore" label="Me: " style="top: auto; flex-direction: row; flex-wrap: wrap; left: 25%; bottom: auto; flex-grow: 0.5; visibility: visible; display: flex; overflow: hidden; opacity: 1; flex-shrink: 0; right: auto;">
