<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/uss/LetterGUI.uss?fileID=7433441132597879392&amp;guid=9ffdbd422dac07d43b76679d81c78d68&amp;type=3#LetterGUI" />
    <engine:VisualElement name="Letter" class="letter">
        <engine:Label name="Content" parse-escape-sequences="true" class="content">
            <engine:VisualElement name="Button-Container" class="button-container" style="align-self: stretch;">
                <engine:Button text="Button" name="Confirm" class="confirm" />
                <engine:Button text="Button" name="Cancel" class="cancel" />
            </engine:VisualElement>
        </engine:Label>
    </engine:VisualElement>
</engine:UXML>
