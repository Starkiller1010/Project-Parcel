.letter {
    align-self: stretch;
    justify-content: space-evenly;
    background-image: resource('Sprite/Square');
    align-items: center;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    flex-shrink: 0;
    flex-grow: 2;
    max-height: 200%;
}

.cancel {
}

.confirm:hover {
    background-color: rgb(16, 183, 0);
    transition-property: background-color, scale;
    transition-duration: initial;
    scale: 1.2 1.2;
    transition-delay: initial;
}

.confirm {
    background-image: url("project://database/Assets/Layer%20Lab/2D%20Icons-PictoIconPack01/Icons/PictoIcon_512/Icon_PictoIcon_Check.Png?fileID=2800000&guid=e5005b1e1ec66431f9be594d0c5bd60b&type=3#Icon_PictoIcon_Check");
    background-color: rgb(124, 130, 125);
    color: rgba(27, 27, 27, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.cancel {
    background-image: url("project://database/Assets/Layer%20Lab/2D%20Icons-PictoIconPack01/Icons/PictoIcon_512/Icon_PictoIcon_Cancel.Png?fileID=2800000&guid=98a4e4019e368429ba9c3282d4bb580c&type=3#Icon_PictoIcon_Cancel");
    background-color: rgb(124, 130, 125);
    color: rgba(27, 27, 27, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.cancel:hover {
    background-color: rgb(183, 14, 0);
    transition-property: background-color, scale;
    transition-duration: initial;
    scale: 1.2 1.2;
    transition-delay: initial;
}

Button {
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    transition-delay: 0.12s;
}

.button-container {
    position: relative;
    bottom: auto;
    flex-direction: row;
    flex-shrink: 0;
    flex-grow: 0;
    justify-content: space-between;
    top: 100%;
    align-self: stretch;
}

.content {
    align-items: center;
    align-self: stretch;
    justify-content: space-evenly;
    -unity-text-align: upper-center;
    font-size: 24px;
}
